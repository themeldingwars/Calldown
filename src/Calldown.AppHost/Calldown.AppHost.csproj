<Project Sdk="Aspire.AppHost.Sdk/13.5.4">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AspireUseCliBundle>true</AspireUseCliBundle>
    <UserSecretsId>40f4a3a2-7b24-44a8-a32b-a88f1bf235e1</UserSecretsId>
    <HasDropPod Condition="Exists('$(DropPodRoot)src\DropPod\DropPod.csproj')">true</HasDropPod>
    <DefineConstants Condition="'$(HasDropPod)' == 'true'">$(DefineConstants);HAS_DROPPOD</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="13.5.4" />
    <PackageReference Include="FauFau" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Calldown.DbSetup\Calldown.DbSetup.csproj" />
    <ProjectReference Include="$(RinRoot)RIN.InternalAPI\RIN.InternalAPI.csproj" />
    <ProjectReference Include="$(RinRoot)RIN.WebAPI\RIN.WebAPI.csproj" />
    <ProjectReference Include="$(PinRoot)UdpHosts\GameServer\GameServer.csproj" />
    <ProjectReference Include="$(PinRoot)UdpHosts\MatrixServer\MatrixServer.csproj" />
    <ProjectReference Include="$(PinRoot)Tools\CollisionGenerator\CollisionGenerator.csproj" />
    <ProjectReference Include="$(DropPodRoot)src\DropPod\DropPod.csproj" Condition="'$(HasDropPod)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RinRoot</_Parameter1>
      <_Parameter2>$(RinRoot)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>PinRoot</_Parameter1>
      <_Parameter2>$(PinRoot)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>DropPodRoot</_Parameter1>
      <_Parameter2>$(DropPodRoot)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
